diff --git a/src/greeklib/xstrings.c b/src/greeklib/xstrings.c
index 7f9fde4..25aa3ff 100755
--- a/src/greeklib/xstrings.c
+++ b/src/greeklib/xstrings.c
@@ -9,7 +9,11 @@ Xstrncpy(char *s1, const char *s2, size_t len)
 /*
 strncpy(s1,s2,len);
 */
-strcpy(s1,s2);
+/* overlap-safe copy: legacy code does things like Xstrncpy(line+4,line+5,...) */
+if( s1 > s2 && s1 < s2 + Xstrlen(s2) + 1 )
+	memmove(s1, s2, (size_t)(Xstrlen(s2) + 1));
+else
+	strcpy(s1,s2);
 return(1);
 }
 	
